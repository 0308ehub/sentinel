{
  "name": "@kismet/sdk",
  "version": "0.1.0",
  "description": "Run Kismet experiments and report events from your app.",
  "homepage": "https://app.sentinelai.one",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./browser": {
      "types": "./browser.d.mts",
      "default": "./browser.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "browser.mjs",
    "browser.d.mts"
  ],
  "engines": {
    "node": ">=18"
  }
}
