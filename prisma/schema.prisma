generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Users & Orgs ────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  documents     Document[]
  conversations Conversation[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  workspaces  Workspace[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── Workspace ────────────────────────────────────────────────────────────────

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents     Document[]
  chunks        DocumentChunk[]
  insights      Insight[]
  painPoints    PainPoint[]
  opportunities Opportunity[]
  conversations Conversation[]
  prds          PRD[]
  tickets       EngineeringTicket[]
  events        ProductEvent[]
  connectors    Connector[]
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id           String             @id @default(cuid())
  workspaceId  String
  uploadedById String
  title        String
  sourceType   DocumentSourceType
  fileType     String?
  originalUrl  String?
  storageKey   String?
  rawText      String?
  status       DocumentStatus     @default(PENDING)
  metadata     Json?
  connectorId  String?
  externalId   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy  User                 @relation(fields: [uploadedById], references: [id])
  chunks      DocumentChunk[]
  extractions DocumentExtraction[]
  connector   Connector?           @relation(fields: [connectorId], references: [id])
}

enum DocumentSourceType {
  UPLOAD
  PASTE
  INTERVIEW
  SUPPORT_TICKET
  ANALYTICS_EXPORT
  SLACK_EXPORT
  SALES_CALL
  USER_FEEDBACK
  INTERNAL_DOC
  MARKET_RESEARCH
  EMAIL
  SLACK
  LINEAR
  JIRA
  INTERCOM
  ZENDESK
  HUBSPOT
}

enum DocumentStatus {
  PENDING
  PARSING
  CHUNKING
  EMBEDDING
  EXTRACTING
  COMPLETED
  FAILED
}

model DocumentChunk {
  id          String                       @id @default(cuid())
  workspaceId String
  documentId  String
  index       Int
  content     String
  tokenCount  Int?
  embedding   Unsupported("vector(1536)")?
  metadata    Json?
  createdAt   DateTime                     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([documentId])
}

model DocumentExtraction {
  id            String   @id @default(cuid())
  documentId    String
  summary       String?
  extractedJson Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ─── Connectors ───────────────────────────────────────────────────────────────

model Connector {
  id           String          @id @default(cuid())
  workspaceId  String
  type         ConnectorType
  name         String
  config       Json
  status       ConnectorStatus @default(PENDING)
  lastSyncedAt DateTime?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  syncLogs  ConnectorSyncLog[]
  documents Document[]
}

model ConnectorSyncLog {
  id                String    @id @default(cuid())
  connectorId       String
  status            String
  documentsImported Int       @default(0)
  error             String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
}

enum ConnectorType {
  GMAIL
  SLACK
  LINEAR
  JIRA
  INTERCOM
  ZENDESK
  HUBSPOT
  NOTION
}

enum ConnectorStatus {
  PENDING
  ACTIVE
  PAUSED
  ERROR
  NEEDS_REAUTH
}

// ─── Insights ─────────────────────────────────────────────────────────────────

model Insight {
  id          String      @id @default(cuid())
  workspaceId String
  type        InsightType
  title       String
  description String
  confidence  Float
  evidenceIds String[]
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

enum InsightType {
  PAIN_POINT
  FEATURE_REQUEST
  OBJECTION
  USER_SEGMENT
  WORKFLOW_ISSUE
  USABILITY_ISSUE
  COMPETITIVE_MENTION
  PRICING_FEEDBACK
  CHURN_REASON
  BUG_REPORT
}

model PainPoint {
  id               String          @id @default(cuid())
  workspaceId      String
  title            String
  description      String
  severity         Int
  frequency        Int
  urgency          Int
  affectedSegments String[]
  evidenceIds      String[]
  status           PainPointStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
}

enum PainPointStatus {
  ACTIVE
  DISMISSED
  SOLVED
}

// ─── Opportunities ────────────────────────────────────────────────────────────

model Opportunity {
  id               String            @id @default(cuid())
  workspaceId      String
  painPointId      String?
  title            String
  description      String
  problemStatement String
  proposedSolution String?
  impactScore      Float
  confidenceScore  Float
  urgencyScore     Float
  effortScore      Float
  riskScore        Float
  totalScore       Float
  targetSegments   String[]
  evidenceIds      String[]
  status           OpportunityStatus @default(PROPOSED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  painPoint PainPoint? @relation(fields: [painPointId], references: [id])
  prds      PRD[]
  tickets   EngineeringTicket[]
}

enum OpportunityStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  SHIPPED
}

// ─── Generated Artifacts ──────────────────────────────────────────────────────

model PRD {
  id             String   @id @default(cuid())
  workspaceId    String
  opportunityId  String?
  title          String
  content        String
  structuredJson Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  tickets     EngineeringTicket[]
}

model EngineeringTicket {
  id                 String         @id @default(cuid())
  workspaceId        String
  opportunityId      String?
  prdId              String?
  title              String
  description        String
  acceptanceCriteria String[]
  priority           TicketPriority
  status             TicketStatus   @default(BACKLOG)
  estimate           String?
  dependencies       String[]
  ticketType         String?
  externalLinearId   String?
  externalLinearUrl  String?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  prd         PRD?         @relation(fields: [prdId], references: [id])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  BACKLOG
  IN_SPRINT
  IN_PROGRESS
  IN_REVIEW
  DONE
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model ProductEvent {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  event       String
  properties  Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}
