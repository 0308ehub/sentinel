{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "app/api/**": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron/scan-connectors", "schedule": "0 9 * * *" },
    { "path": "/api/cron/sync-linear",     "schedule": "0 10 * * *" },
    { "path": "/api/cron/daily-digest",    "schedule": "0 8 * * *" }
  ]
}
