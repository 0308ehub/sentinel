{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "app/api/**": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron/scan-connectors", "schedule": "0 * * * *" },
    { "path": "/api/cron/sync-linear",     "schedule": "*/30 * * * *" }
  ]
}
