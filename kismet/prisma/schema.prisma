// Product IDE — Knowledge Graph Schema
// Run: npx prisma generate && npx prisma db push && npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NodeType {
  PRODUCT
  FEATURE
  CUSTOMER_PROBLEM
  CUSTOMER
  USER_SEGMENT
  REQUIREMENT
  DECISION
  GOAL
  EXPERIMENT
  METRIC
  DASHBOARD
  ANALYTICS_QUERY
  PRD
  DESIGN
  FIGMA_FRAME
  ENGINEERING_TASK
  PULL_REQUEST
  COMMIT
  RELEASE
  LAUNCH
  SUPPORT_TICKET
  CUSTOMER_INTERVIEW
  SLACK_THREAD
  MEETING
  ACTION_ITEM
  TEAM
  PERSON
  API
  DATABASE_TABLE
  SERVICE
  AI_INSIGHT
}

enum RelationshipType {
  ADDRESSES
  IMPLEMENTS
  BLOCKS
  DEPENDS_ON
  MEASURES
  OWNED_BY
  RELATED_TO
  SUPERSEDES
  VALIDATES
  CAUSED_BY
  RESULTED_IN
  PART_OF
  LINKED_TO
}

enum NodeStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  COMPLETED
  ARCHIVED
  AT_RISK
  STALE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  teams    Team[]
  people   Person[]
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members Person[]
}

model Person {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id])
  clerkUserId    String?      @unique
  name           String
  email          String
  avatarUrl      String?
  role           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ownedNodes GraphNode[] @relation("NodeOwner")
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  status         NodeStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  nodes GraphNode[]
}

model GraphNode {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  type        NodeType
  title       String
  description String?    @db.Text
  summary     String?    @db.Text
  status      NodeStatus @default(DRAFT)
  priority    Priority?
  ownerId     String?
  owner       Person?    @relation("NodeOwner", fields: [ownerId], references: [id])
  metadata    Json       @default("{}")
  tags        String[]   @default([])
  searchText  String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  outgoingEdges GraphEdge[]     @relation("SourceNode")
  incomingEdges GraphEdge[]     @relation("TargetNode")
  timeline      TimelineEvent[]
  activities    Activity[]

  @@index([productId, type])
  @@index([status])
  @@index([ownerId])
}

model GraphEdge {
  id        String           @id @default(cuid())
  sourceId  String
  source    GraphNode        @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    GraphNode        @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)
  type      RelationshipType
  label     String?
  weight    Float?
  createdAt DateTime         @default(now())

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
}

model TimelineEvent {
  id          String    @id @default(cuid())
  nodeId      String
  node        GraphNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  eventType   String
  timestamp   DateTime
  actorId     String?
  metadata    Json      @default("{}")

  @@index([nodeId, timestamp])
}

model Activity {
  id          String     @id @default(cuid())
  nodeId      String?
  node        GraphNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  type        String
  title       String
  description String?
  actorId     String
  timestamp   DateTime   @default(now())

  @@index([timestamp])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  type        String
  read        Boolean  @default(false)
  nodeId      String?
  createdAt   DateTime @default(now())

  @@index([userId, read])
}

model SavedQuery {
  id          String   @id @default(cuid())
  productId   String
  name        String
  description String?
  sql         String   @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GraphSnapshot {
  id        String   @id @default(cuid())
  productId String
  name      String
  message   String?
  data      Json
  createdAt DateTime @default(now())
  createdBy String

  @@index([productId, createdAt])
}
