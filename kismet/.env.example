# Kismet's own database. In Supabase, open Connect and paste the URI here.
# Use Direct connection for a long-running server. On Vercel, paste the shared pooler URI from that same dialog.
# The anon key and the service role key are not the database password.
DATABASE_URL=

# Or leave DATABASE_URL empty and set these. The app connects directly to the database.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_DB_PASSWORD=

# Optional. When set, chat reads open issues and pull requests from this repo.
# KISMET_GITHUB_REPO=owner/name

# Clerk Authentication (optional for local dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Slack (Bot User OAuth Token from api.slack.com/apps → OAuth & Permissions)
# Mentions need chat:write as well as the read scopes, then reinstall the app.
SLACK_BOT_TOKEN=

# Jira Cloud
# JIRA_BASE_URL is the site address in the browser, like https://your-site.atlassian.net
# JIRA_EMAIL is the Atlassian account that can open that site
# JIRA_API_TOKEN is created at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Databricks SQL warehouse
# DATABRICKS_HOST is the workspace URL in the browser, like https://dbc-xxxx.cloud.databricks.com
# DATABRICKS_TOKEN is created under your user icon → Settings → Developer → Access tokens
# DATABRICKS_HTTP_PATH is on the SQL warehouse → Connection details, like /sql/1.0/warehouses/abc123
# DATABRICKS_CATALOG and DATABRICKS_SCHEMA are optional
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# OpenAI (for AI Workspace in production)
OPENAI_API_KEY=

# GitHub
# Fine-grained tokens need Contents (read and write), Pull requests (read and write), and Metadata (read) on the repo you will test.
# Classic tokens need the repo scope. Create one at https://github.com/settings/tokens
# Fork a small app into your account first. Kismet can only open a pull request where this token can push.
GITHUB_TOKEN=

# Model spend cap. Amounts are cents per UTC day. The per-minute cap is requests.
# Defaults are $10 per account, $50 for the whole site, and 20 requests a minute.
KISMET_AI_USER_DAILY_CENTS=1000
KISMET_AI_DAILY_CENTS=5000
KISMET_AI_PER_MINUTE=20

# Public site origin used by the sitemap and Open Graph tags.
KISMET_SITE_URL=https://app.sentinelai.one
